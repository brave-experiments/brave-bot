# Template for direnv. Copy and fill in real values:
#
#   cp .envrc.example .envrc && direnv allow
#
# .envrc itself is gitignored — never commit real key material.

# Brave services HMAC signing key for the aichat backend.
# This is a signing key, not a bearer token: it is used to HMAC-SHA256 the
# request body digest and is never transmitted.
# Matched pair with BRAVE_SERVICES_KEY_ID below — the server derives its copy
# of this key from a master seed plus that id, so the two must correspond.
export SERVICES_KEY_AICHAT="replace-me"

# keyId sent in the Authorization header.
export BRAVE_SERVICES_KEY_ID="replace-me"

# Base URL of the aichat backend. The client appends the API path
# (v1/chat/completions), matching brave-core's GetEndpointUrl().
#
# Host is "<prefix>.<services-domain>" where the domains come from
# brave-core's brave_domains buildflags:
#   prod     ai-chat.bsg.brave.com
#   staging  ai-chat.bsg.bravesoftware.com
#   dev      ai-chat.bsg.brave.software
#
# The premium tier uses the ai-chat-premium.bsg prefix instead; brave-core
# selects it when a SKU credential is present.
export BRAVE_AI_CHAT_ENDPOINT="https://ai-chat.bsg.brave.com"

# Point this at a local server for development, e.g.
# export BRAVE_AI_CHAT_ENDPOINT="http://localhost:8080"

# Model to request from POST /v1/chat/completions.
# "automatic" lets the server triage per request and is the default.
# Note: a value the server does not recognize is silently reset to
# "automatic", and some model entries are weighted ensembles that resolve
# randomly — so the model you request is not necessarily the one you get.
# Always trust the model reported in the response.
export MODEL="automatic"
